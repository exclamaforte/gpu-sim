+    # gpu-sim-kvcp: Llama-3-8B uses GQA with 8 KV heads, so the K/V blocks a ring CP
+    # exchanges are n_kv_heads*head_dim = 1024 wide, NOT d_model = 4096. The CP term used
+    # d_model and therefore overstated context-parallel traffic by 4x on this model. Set
+    # n_kv_heads == n_heads for MHA; absent means MHA (kv width = d_model).
+    "n_kv_heads": 8,
     "head_dim": 128,
     "d_ff": 14336,
     "vocab": 128256,
@@ -301,7 +306,9 @@ def score(tp, pp, cp, dp, zero, hw, m):
     cp_comm = 0.0
