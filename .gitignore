# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# fakegpu build artifacts
#
# libfakegpu.so is the one that matters most: a fresh checkout without a
# build has no libfakegpu.so, so `make check` can pass VACUOUSLY. Ignoring a
# build product is not cosmetic here -- it must never be committed, and its
# absence must never be mistaken for a green quality gate.
*.o
libfakegpu.so
build/

# build artifacts that must never be committed (gpu-sim-u2o.6.6.1)
**__pycache__/
*.pyc
*.out

# --- gpu-sim-u2o.6.11: what must never enter git, and why -----------------
# Bytecode caches: regenerated on every import, and a tracked .pyc is a merge
# obstacle that can silently resurrect stale bytecode. A .gitignore rule does
# NOT untrack an already-committed .pyc -- that needs `git rm --cached` -- so
# this rule only binds branches cut after it.
**__pycache__/
*.pyc

# Shared-library build output. libfakegpu.so is produced by `make` from
# shim/ and src/, both of which ARE tracked: a tracked .so is a binary blob
# that goes stale against its own source and is architecture-specific.
*.so

# Compiled CUDA/C++ objects and executables produced by the experiment
# scripts on every run. They are outputs, not inputs: experiments rebuild
# them (gpu-sim-u2o.6.6.1's reference_kernel.out, the anchor binaries).
*.o
*.out

# Result artifacts do not belong beside the source. Measurements live in
# experiments/<bd-id>/, where the bead that produced them stamps them with a
# version and the ts job id they came from. A .json dropped in epic_u2o/ is
# unversioned by construction -- that is how a synthetic fixture nearly became
# the record of a real measurement (gpu-sim-u2o.15).
# Deliberately NOT ignored: *.md specification files. They are inputs, and a
# few of them are stubs; those are left untracked by DECISION, recorded in
# experiments/gpu-sim-u2o.6.11/tracks_inventory.md, not hidden by a rule.

# Lab runtime state: worktrees, unix sockets, daemon files. The .lab/ tree
# holds a git worktree per agent session plus live sockets -- none of it belongs
# in git. Mirrors the rule set cclm uses.
.lab/wt/
.lab/*.sock
.lab/labd.log
.lab/labd.pid
.lab/labd-state.json

# Phase A build outputs: 264 generated .cu sources and the manifest are
# regenerated by build_batch.py, and the .out binaries by compile_all.py.
# The measured dataset (measured.jsonl) IS committed; these are not.
experiments/*/build/

# gpu-sim-m3d.8 (experiment-local)
tests/test_oversized
experiments/*/build/
# m3d.6 launcher runtime output
runs/
exp_out/

# stray manual build of the shim size test (the Makefile builds it under build/)
tests/test_shim_prop_size
# m3d.5: probe binary
experiments/*/bin/
