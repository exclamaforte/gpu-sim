{
  "daemon": {
    "pollSeconds": 20
  },
  "gpqueue": {
    "ts": "~/.local/bin/ts",
    "gpqueuePy": "~/Documents/gpqueue/gpqueue.py"
  },
  "roles": {
    "pi": {
      "sessionId": "lab-pi",
      "name": "Lab PI",
      "model": "deepseek-v4.1-flash",
      "prompt": ".lab/prompts/pi.md",
      "thinking": "max",
      "tools": null
    },
    "implementer": {
      "sessionId": "lab-implementer",
      "name": "Lab Implementer",
      "model": "Beam-501B-A23B",
      "thinking": "max",
      "prompt": ".lab/prompts/implementer.md",
      "tools": null
    },
    "reviewer": {
      "sessionId": "lab-reviewer",
      "name": "Lab Reviewer",
      "model": "deepseek-v4.1-flash",
      "thinking": "max",
      "prompt": ".lab/prompts/reviewer.md",
      "tools": null
    }
  },
  "tests": {
    "command": [
      "python",
      "-m",
      "pytest",
      "tests/"
    ],
    "build": [
      "make"
    ]
  }
}
